generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
}

// Papéis (ADR-016). SUPER_ADMIN administra o sistema; USER opera só os próprios dados.
enum UserRole {
  SUPER_ADMIN
  USER
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

// Dono dos dados (ADR-017): Group, Campaign e CampaignMedia pertencem a um User. Os demais dados
// herdam o dono pela campanha. Chaves compostas (userId, id) permitem que o BANCO recuse vincular
// campanha a grupo ou mídia de outro usuário.
model Group {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  // Único por dono: dois usuários podem participar do mesmo grupo do WhatsApp.
  externalId String?
  name       String          @db.VarChar(255)
  active     Boolean         @default(true)
  // Situação na última sincronização/envio; null = desconhecida.
  adminOnly  Boolean?
  isAdmin    Boolean?
  // Quantidade de membros na última sincronização/envio (identifica grupos de nome igual).
  participants Int?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deliveries Delivery[]
  campaigns  CampaignGroup[]
  lists      GroupListItem[]

  @@unique([userId, externalId])
  @@unique([userId, id])
}

// Listas de grupos (ADR-047): um nome para um conjunto de grupos ("Universitários"), para marcar
// todos de uma vez ao montar a campanha. A lista é do usuário e só aponta para grupos dele (as
// chaves compostas com userId fazem o banco recusar grupo de outra conta).
model GroupList {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String          @db.VarChar(80)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     GroupListItem[]

  @@unique([userId, name])
  @@unique([userId, id])
}

model GroupListItem {
  listId  String
  groupId String
  userId  String
  list    GroupList @relation(fields: [userId, listId], references: [userId, id], onDelete: Cascade)
  group   Group     @relation(fields: [userId, groupId], references: [userId, id], onDelete: Cascade)

  @@id([listId, groupId])
  @@index([userId, listId])
  @@index([userId, groupId])
}

model Campaign {
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  mediaId         String?
  // A mídia precisa ser do mesmo dono da campanha (chave composta).
  media           CampaignMedia?     @relation(fields: [userId, mediaId], references: [userId, id], onDelete: Restrict)
  id              String             @id @default(cuid())
  name            String             @db.VarChar(200)
  startsAt        DateTime
  endsAt          DateTime
  status          CampaignStatus     @default(DRAFT)
  provider        String             @default("simulator")
  accountJid      String?
  mode            String             @default("SCHEDULED")
  intervalSeconds Int                @default(120)
  // Marcar todos os membros do grupo em cada envio (menção em massa, ADR-029).
  mentionAll      Boolean            @default(false)
  nextAvailableAt DateTime?
  pausedAt        DateTime?
  deletedAt       DateTime?
  // Link público do relatório (ADR-045): quem tem o código vê só os números da campanha, sem
  // login. null = sem link. O dono cria e desativa quando quiser.
  reportToken     String?            @unique @db.VarChar(64)
  // Modelo (ADR-047): uma campanha guardada para reaproveitar. Fica sempre em rascunho, fora da
  // lista de campanhas, nunca é enviada e não entra no prazo de guarda; "usar" cria uma cópia.
  isTemplate      Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  messages        CampaignMessage[]
  schedules       CampaignSchedule[]
  deliveries      Delivery[]
  groups          CampaignGroup[]

  @@unique([userId, id])
  @@index([userId, mediaId])
  // Lista de campanhas paginada por dono, mais recentes primeiro.
  @@index([userId, createdAt])
  // Índice criado pelo MySQL junto com a antiga chave da mídia; mantido (útil e sem risco).
  @@index([mediaId], map: "Campaign_mediaId_fkey")
}

model CampaignGroup {
  campaignId String
  groupId    String
  // Dono da campanha E do grupo: as duas chaves compostas exigem que sejam o mesmo usuário.
  userId     String
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [userId, campaignId], references: [userId, id], onDelete: Cascade)
  group      Group    @relation(fields: [userId, groupId], references: [userId, id], onDelete: Cascade)

  @@id([campaignId, groupId])
  @@index([groupId])
  @@index([userId, campaignId])
  @@index([userId, groupId])
}

model CampaignMessage {
  id         String   @id @default(cuid())
  campaignId String
  content    String   @db.Text
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model CampaignSchedule {
  id         String   @id @default(cuid())
  campaignId String
  time       String
  timezone   String   @default("America/Sao_Paulo")
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model Delivery {
  id          String         @id @default(cuid())
  campaignId  String
  groupId     String
  messageBody String         @db.Text
  scheduledAt DateTime
  sentAt      DateTime?
  status      DeliveryStatus @default(PENDING)
  provider    String         @default("simulator")
  providerId  String?
  error       String?        @db.Text
  sequence    Int            @default(0)
  attemptedAt DateTime?
  // Observabilidade do envio (ADR-012). attemptedAt = início da tentativa; sendReturnedAt =
  // quando o sendMessage retornou (ou falhou). SENT só diz que o WhatsApp recebeu o pedido:
  // deliveredAt (primeiro recibo de entrega de um participante) e serverRejectedAt (recusa
  // do servidor após o envio) dizem o que aconteceu depois.
  attempts         Int       @default(0)
  sendReturnedAt   DateTime?
  errorCode        String?   @db.VarChar(64)
  deliveredAt      DateTime?
  serverRejectedAt DateTime?
  // Situação do grupo no momento do envio (ex.: "membro=sim admin=nao so-admins=sim"), para
  // explicar recusas depois do fato.
  sendContext      String?   @db.VarChar(160)
  reads       DeliveryRead[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  campaign    Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  group       Group          @relation(fields: [groupId], references: [id])

  @@unique([campaignId, groupId, scheduledAt])
  @@unique([campaignId, sequence])
  @@index([status, scheduledAt])
  // Limite diário por número (ADR-041): conta as tentativas do dia.
  @@index([attemptedAt])
  @@index([campaignId, scheduledAt])
  @@index([providerId])
}

model CampaignMedia {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  name      String     @db.VarChar(255)
  mimeType  String
  kind      String
  size      Int
  data      Bytes
  // Cor predominante (#rrggbb) e miniatura WebP pequena, geradas a partir da imagem no upload
  // (ADR-026). Deixam a lista de campanhas leve: o cartão nunca baixa a mídia inteira.
  color     String?    @db.VarChar(7)
  thumbnail Bytes?     @db.MediumBlob
  createdAt DateTime   @default(now())
  campaigns Campaign[]

  @@unique([userId, id])
}

model PendingRead {
  id            String   @id
  messageId     String
  groupJid      String
  accountJid    String
  participant   String
  readAt        DateTime
  nextAttemptAt DateTime @default(now())
  // Dono da conexão que recebeu o recibo (ADR-022). Um recibo só casa com envios desse dono.
  // null = recibo gravado pela sessão global legada, antes do dono ser conhecido (some na 4E).
  ownerId       String?

  @@index([nextAttemptAt])
  @@index([ownerId])
}

model DeliveryRead {
  id            String   @id @default(cuid())
  deliveryId    String
  recipientHash String
  readAt        DateTime
  delivery      Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, recipientHash])
  @@index([readAt])
}

// Substitui o lock Redis `campaign:worker-owner`. Linha única (id = "worker"):
// garante um processador por vez sem depender de um serviço externo.
model WorkerLease {
  id        String   @id
  ownerId   String
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}

// Usuários do painel. Não há cadastro público: o primeiro é criado por ADMIN_EMAIL/
// ADMIN_PASSWORD na primeira subida ou por `npm run user:create`.
model User {
  id           String        @id @default(cuid())
  email        String        @unique @db.VarChar(191)
  name         String        @db.VarChar(120)
  passwordHash String        @db.VarChar(255)
  role         UserRole      @default(USER)
  disabledAt   DateTime?
  // Aceite dos Termos de Uso e da Política de Privacidade (ADR-040): quando e qual versão.
  // Versão diferente da atual = o painel pede o aceite de novo.
  termsAcceptedAt DateTime?
  termsVersion    String?   @db.VarChar(20)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     AuthSession[]
  whatsapp     WhatsAppSession?
  campaigns    Campaign[]
  groups       Group[]
  media        CampaignMedia[]
  sendingPolicy SendingPolicy?
  feedback     Feedback[]
  groupLists   GroupList[]
  passwordResets PasswordReset[]
  alertSettings AlertSettings?
  alerts       OwnerAlert[]
}

// Avisos no WhatsApp do dono (ADR-048): preferência da conta. Sem linha = desligado.
model AlertSettings {
  userId    String    @id
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled   Boolean   @default(false)
  // Número que recebe os avisos (só dígitos, com DDI). null = o próprio número conectado.
  phone     String?   @db.VarChar(20)
  // Só o que acontecer depois disto vira aviso: ligar não despeja o que já passou.
  enabledAt DateTime?
  updatedAt DateTime  @updatedAt
}

// Um aviso para o dono (ADR-048). `key` identifica o fato (ex.: "fim:<campanha>:<último envio>"):
// o mesmo fato nunca gera dois avisos. sentAt e error nulos = ainda na fila de saída.
model OwnerAlert {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String    @unique @db.VarChar(120)
  text      String    @db.VarChar(1000)
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  error     String?   @db.VarChar(255)

  @@index([userId, createdAt])
  @@index([sentAt, createdAt])
}

// "Esqueci minha senha" (ADR-047). Uma linha por pedido. Sem tokenHash = a pessoa pediu e ainda
// não há link (o administrador gera). Com tokenHash = link de uso único; aqui fica só o hash
// SHA-256 do código, como nas sessões. Usar o link apaga todas as linhas da conta.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String?   @unique @db.Char(64)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// Sugestões, críticas, problemas e elogios dos usuários sobre o sistema (ADR-045). O administrador
// lê, muda a situação e pode responder; quem enviou vê a resposta na mesma tela.
model Feedback {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // sugestao | problema | critica | elogio
  kind        String    @db.VarChar(20)
  message     String    @db.Text
  // novo | analisando | feito | recusado
  status      String    @default("novo") @db.VarChar(20)
  reply       String?   @db.Text
  repliedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// Proteção do número (ADR-041): regras de envio da conta. Sem linha = padrões seguros
// (DEFAULT_RULES em sending-policy.ts). null em uma regra = regra desligada.
model SendingPolicy {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Janela de silêncio, em minutos desde 00:00 no horário de São Paulo (ex.: 1320 = 22:00).
  quietStart      Int?
  quietEnd        Int?
  // Envios por número por dia.
  dailyLimit      Int?
  // Espera mínima antes de mandar de novo para o mesmo grupo.
  groupGapMinutes Int?
  // Pausar as campanhas ao ver sinal de restrição do WhatsApp.
  autoPause       Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

// Sessão de login. O cookie leva um token aleatório; aqui fica só o hash SHA-256 dele,
// então um vazamento do banco não entrega sessões válidas.
model AuthSession {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique @db.Char(64)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  ip         String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(255)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Ritmo de envio de um número de WhatsApp (ADR-006). Todas as campanhas que usam o mesmo
// número compartilham esta linha: o intervalo vale para o NÚMERO, não para cada campanha.
// id = JID da conta (Campaign.accountJid). Persistido para valer também após reinício.
model WhatsAppAccount {
  id                  String    @id
  // Antes disto nenhuma campanha pode enviar por este número.
  nextAvailableAt     DateTime?
  // Fim do último envio (ou falha) e o intervalo da campanha que enviou.
  lastSendEndedAt     DateTime?
  lastIntervalSeconds Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt
}

// Conexão de WhatsApp de um usuário (ADR-019, Fase 4A). Guarda só o que o painel e a partida
// precisam saber; NADA de credencial: creds.json e as chaves do Baileys continuam em arquivos,
// na pasta da sessão daquele usuário (session-paths.ts). QR nunca é persistido.
// Nesta arquitetura inicial: uma conexão por usuário e um número em um só usuário.
model WhatsAppSession {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Número pareado (JID). Fica null até o pareamento; vários null convivem, mas um número
  // pareado pertence a um único usuário (@unique).
  accountJid      String?   @unique
  // Último estado conhecido, só para exibição: disconnected, connecting, qr, connected,
  // reconnecting, error. A verdade em tempo real continua na memória do provider.
  state           String    @default("disconnected") @db.VarChar(20)
  lastConnectedAt DateTime?
  lastError       String?   @db.VarChar(255)
  // Reconectar sozinho na partida (Fase 4B). Usuário desativado não reconecta.
  autoConnect     Boolean   @default(true)
  // Pausa automática por sinal de restrição (ADR-041): quando e por quê. safetyReason fica
  // até a pessoa dispensar o aviso; safetyPausedAt fica para não contar de novo os mesmos sinais.
  safetyPausedAt  DateTime?
  safetyReason    String?   @db.VarChar(255)
  // Aquecimento de número novo (ADR-043). warmupJid = número a que a resposta se refere (outro
  // número conectado = pergunta de novo). warmupStartedAt = início do aquecimento; null = o dono
  // disse que o número não é novo.
  warmupJid       String?
  warmupStartedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
