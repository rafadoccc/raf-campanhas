generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

model Group {
  id         String          @id @default(cuid())
  externalId String?         @unique
  name       String          @db.VarChar(255)
  active     Boolean         @default(true)
  // Situação na última sincronização/envio; null = desconhecida.
  adminOnly  Boolean?
  isAdmin    Boolean?
  // Quantidade de membros na última sincronização/envio (identifica grupos de nome igual).
  participants Int?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deliveries Delivery[]
  campaigns  CampaignGroup[]
}

model Campaign {
  mediaId         String?
  media           CampaignMedia?     @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  id              String             @id @default(cuid())
  name            String             @db.VarChar(200)
  startsAt        DateTime
  endsAt          DateTime
  status          CampaignStatus     @default(DRAFT)
  provider        String             @default("simulator")
  accountJid      String?
  mode            String             @default("SCHEDULED")
  intervalSeconds Int                @default(180)
  nextAvailableAt DateTime?
  pausedAt        DateTime?
  deletedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  messages        CampaignMessage[]
  schedules       CampaignSchedule[]
  deliveries      Delivery[]
  groups          CampaignGroup[]
}

model CampaignGroup {
  campaignId String
  groupId    String
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([campaignId, groupId])
  @@index([groupId])
}

model CampaignMessage {
  id         String   @id @default(cuid())
  campaignId String
  content    String   @db.Text
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model CampaignSchedule {
  id         String   @id @default(cuid())
  campaignId String
  time       String
  timezone   String   @default("America/Sao_Paulo")
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model Delivery {
  id          String         @id @default(cuid())
  campaignId  String
  groupId     String
  messageBody String         @db.Text
  scheduledAt DateTime
  sentAt      DateTime?
  status      DeliveryStatus @default(PENDING)
  provider    String         @default("simulator")
  providerId  String?
  error       String?        @db.Text
  sequence    Int            @default(0)
  attemptedAt DateTime?
  // Observabilidade do envio (ADR-012). attemptedAt = início da tentativa; sendReturnedAt =
  // quando o sendMessage retornou (ou falhou). SENT só diz que o WhatsApp recebeu o pedido:
  // deliveredAt (primeiro recibo de entrega de um participante) e serverRejectedAt (recusa
  // do servidor após o envio) dizem o que aconteceu depois.
  attempts         Int       @default(0)
  sendReturnedAt   DateTime?
  errorCode        String?   @db.VarChar(64)
  deliveredAt      DateTime?
  serverRejectedAt DateTime?
  // Situação do grupo no momento do envio (ex.: "membro=sim admin=nao so-admins=sim"), para
  // explicar recusas depois do fato.
  sendContext      String?   @db.VarChar(160)
  reads       DeliveryRead[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  campaign    Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  group       Group          @relation(fields: [groupId], references: [id])

  @@unique([campaignId, groupId, scheduledAt])
  @@unique([campaignId, sequence])
  @@index([status, scheduledAt])
  @@index([campaignId, scheduledAt])
  @@index([providerId])
}

model CampaignMedia {
  id        String     @id @default(cuid())
  name      String     @db.VarChar(255)
  mimeType  String
  kind      String
  size      Int
  data      Bytes
  createdAt DateTime   @default(now())
  campaigns Campaign[]
}

model PendingRead {
  id            String   @id
  messageId     String
  groupJid      String
  accountJid    String
  participant   String
  readAt        DateTime
  nextAttemptAt DateTime @default(now())

  @@index([nextAttemptAt])
}

model DeliveryRead {
  id            String   @id @default(cuid())
  deliveryId    String
  recipientHash String
  readAt        DateTime
  delivery      Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, recipientHash])
  @@index([readAt])
}

// Substitui o lock Redis `campaign:worker-owner`. Linha única (id = "worker"):
// garante um processador por vez sem depender de um serviço externo.
model WorkerLease {
  id        String   @id
  ownerId   String
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}

// Usuários do painel. Não há cadastro público: o primeiro é criado por ADMIN_EMAIL/
// ADMIN_PASSWORD na primeira subida ou por `npm run user:create`.
model User {
  id           String        @id @default(cuid())
  email        String        @unique @db.VarChar(191)
  name         String        @db.VarChar(120)
  passwordHash String        @db.VarChar(255)
  role         String        @default("OWNER") @db.VarChar(20)
  disabledAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     AuthSession[]
}

// Sessão de login. O cookie leva um token aleatório; aqui fica só o hash SHA-256 dele,
// então um vazamento do banco não entrega sessões válidas.
model AuthSession {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique @db.Char(64)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  ip         String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(255)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Ritmo de envio de um número de WhatsApp (ADR-006). Todas as campanhas que usam o mesmo
// número compartilham esta linha: o intervalo vale para o NÚMERO, não para cada campanha.
// id = JID da conta (Campaign.accountJid). Persistido para valer também após reinício.
model WhatsAppAccount {
  id                  String    @id
  // Antes disto nenhuma campanha pode enviar por este número.
  nextAvailableAt     DateTime?
  // Fim do último envio (ou falha) e o intervalo da campanha que enviou.
  lastSendEndedAt     DateTime?
  lastIntervalSeconds Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt
}
