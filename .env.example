# Aplicação
WEB_PORT=3000
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Sessões do WhatsApp ficam FORA desta pasta (que é sincronizada pelo OneDrive).
# No Windows, se esta variável não existir, o padrão já é %LOCALAPPDATA%\raf-campanhas\sessions.
# SESSIONS_DIR=C:\Users\SEU_USUARIO\AppData\Local\raf-campanhas\sessions

# MySQL 8 local (serviço MySQL80). Troque SUA_SENHA pela senha do usuário root do MySQL.
# O banco "campanhas" é criado automaticamente pelo npm run db:check / launcher.
DATABASE_URL=mysql://root:SUA_SENHA@localhost:3306/campanhas
