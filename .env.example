# ─── Servidor ──────────────────────────────────────────────────────────────────
# Uma única porta serve o painel e a API. Na Hostinger, use a porta que ela indicar.
PORT=3000

# Endereço público do sistema. Localmente pode ficar comentado (vale http://localhost:PORT).
# Publicado, é obrigatório: define o domínio aceito, o cookie seguro (https) e o proxy.
# No Railway não precisa: vale https://RAILWAY_PUBLIC_DOMAIN (defina só para domínio próprio).
# PUBLIC_URL=https://campanhas.seudominio.com.br

# Interface de rede. Padrão: 127.0.0.1 no PC; 0.0.0.0 quando publicado ou no Railway.
# HOST=0.0.0.0

# ─── Banco MySQL ───────────────────────────────────────────────────────────────
# Local (serviço MySQL80): o banco "campanhas" é criado sozinho pelo npm run db:check.
# Hostinger: crie o banco no hPanel (o nome vem com prefixo, ex.: u123456789_campanhas).
DATABASE_URL=mysql://root:SUA_SENHA@localhost:3306/campanhas

# ─── Primeiro usuário do painel ─────────────────────────────────────────────────
# Usado só se ainda não existir nenhum usuário. Depois de entrar, apague a senha daqui.
# Localmente o inicializador (.exe) também pergunta e-mail e senha na primeira vez.
# ADMIN_EMAIL=voce@exemplo.com
# ADMIN_PASSWORD=uma-senha-com-10-ou-mais-caracteres
# ADMIN_NAME=Seu nome

# ─── Privacidade (LGPD) ────────────────────────────────────────────────────────
# E-mail de contato mostrado na Política de Privacidade e nos Termos de Uso (/privacidade e
# /termos). É o canal para os titulares pedirem acesso, correção ou exclusão dos dados.
# CONTACT_EMAIL=contato@exemplo.com

# Chave que cifra a sessão do WhatsApp guardada no servidor (credencial e chaves de cada número).
# Opcional: sem ela, os arquivos ficam em texto puro, como sempre. Com ela, quem copiar a pasta de
# sessões ou um backup não consegue usar o WhatsApp dos clientes.
# Gere uma vez:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ATENÇÃO: guarde esta chave fora do servidor. Se ela se perder ou for trocada, as sessões já
# cifradas não abrem mais (o sistema avisa e não apaga nada) e cada número terá de ler o QR de novo.
# SESSION_KEY=

# ─── E-mail (esqueci minha senha) ──────────────────────────────────────────────
# Opcional. Sem estas duas variáveis, o pedido de senha nova aparece na Administração e o
# administrador gera o link e manda para a pessoa (WhatsApp, por exemplo).
# Com as duas, o link vai sozinho para o e-mail da conta, pelo serviço Resend (resend.com).
# MAIL_FROM precisa ser de um domínio verificado no Resend. Defina as duas ou nenhuma.
# RESEND_API_KEY=
# MAIL_FROM=DocDrop <nao-responda@seudominio.com.br>

# ─── Opcionais ─────────────────────────────────────────────────────────────────
# Onde guardar a sessão do WhatsApp. Precisa ficar FORA da pasta do app: na Hostinger cada
# deploy troca a pasta do app, e a sessão perdida exige ler o QR de novo.
# Padrão: %LOCALAPPDATA%\raf-campanhas\sessions (Windows) ou ~/.local/state/raf-campanhas/sessions.
# SESSIONS_DIR=/home/u123456789/campanhas-sessoes

# Validade do login, em horas (padrão 168 = 7 dias; renovada com o uso).
# SESSION_TTL_HOURS=168

# Nível de log do servidor: warn (padrão), info, error.
# LOG_LEVEL=warn

# ─── VPS pequena (1 vCPU, 1 GB de RAM) ─────────────────────────────────────────
# Veja docs/deploy-vps.md. Resumo:
# - No DATABASE_URL, acrescente ?connection_limit=5 (poucas conexões = menos memória no MySQL).
# - Teto de memória do Node, para ele liberar memória antes de o sistema matar o processo:
# NODE_OPTIONS=--max-old-space-size=384
