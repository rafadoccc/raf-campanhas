# Aplicação
WEB_PORT=3000
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# PostgreSQL local (instalação nativa no Windows, sem Docker).
# Troque SUA_SENHA pela senha do usuário do PostgreSQL.
# O schema "campanhas" isola as tabelas deste projeto dentro de main_db.
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/main_db?schema=campanhas
# Sessões do WhatsApp ficam FORA desta pasta (que é sincronizada pelo OneDrive).
# No Windows, se esta variável não existir, o padrão já é %LOCALAPPDATA%\raf-campanhas\sessions.
# SESSIONS_DIR=C:\Users\SEU_USUARIO\AppData\Local\raf-campanhas\sessions