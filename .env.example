# Aplicação
WEB_PORT=3000
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# PostgreSQL local (instalação nativa no Windows, sem Docker).
# Troque SUA_SENHA pela senha do usuário do PostgreSQL.
# O schema "campanhas" isola as tabelas deste projeto dentro de main_db.
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/main_db?schema=campanhas
